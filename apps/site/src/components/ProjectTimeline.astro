---

<section id="history" class="history-section">
  <div class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROJECT HISTORY</p>
        <h2>A short history with a deliberate sequence.</h2>
      </div>
      <p>
        The public repository history starts on 2 October 2026. Each step adds a new capability
        without collapsing building truth, device identity, live state, or presentation into one store.
      </p>
    </div>

    <ol class="project-timeline">
      {events.map((event, index) => (
        <li>
          <div class="timeline-rail" aria-hidden="true">
            <span class:list={["timeline-dot", { "in-progress": event.status === "in progress" }]}></span>
          </div>
          <article>
            <div class="timeline-meta">
              <time>{event.date}</time>
              <span>{event.status}</span>
              <b>0{index + 1}</b>
            </div>
            <h3>{event.title}</h3>
            <p>{event.copy}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
