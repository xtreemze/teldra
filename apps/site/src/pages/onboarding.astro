---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const steps = [
  ["01", "Understand authority", "IFC owns architecture. The Teldra twin format owns devices, capabilities, external bindings, and runtime semantics."],
  ["02", "Choose an entry path", "Bring an IFC model, use the planned semantic Sweet Home 3D import path, or work from the repository's deterministic fixtures."],
  ["03", "Run the workspace", "Install with pnpm, then execute schema, type, architecture, quality, and test checks before changing a boundary."],
  ["04", "Project, don't duplicate", "Renderers consume projections. Babylon.js, deck.gl, Blender, and Home Assistant integrations stay outside canonical domain contracts."],
];
---

<BaseLayout
  title="Onboarding — Teldra"
  description="Get oriented with Teldra's BIM-backed digital-twin architecture and repository workflow."
>
  <section class="guide-hero section-shell compact">
    <a class="back-link" href={base}>← Teldra home</a>
    <p class="eyebrow">ONBOARDING</p>
    <h1>Build on the twin without breaking its authority model.</h1>
    <p class="hero-lede">
      Teldra is early-stage infrastructure. This guide gets contributors and evaluators to
      the right mental model first, then to a working local repository.
    </p>
  </section>

  <section class="section-shell guide-grid">
    <aside class="guide-index" aria-label="Onboarding sections">
      <strong>Start here</strong>
      <a href="#mental-model">Mental model</a>
      <a href="#entry-paths">Entry paths</a>
      <a href="#local">Local setup</a>
      <a href="#first-change">First change</a>
    </aside>

    <div class="guide-content">
      <section id="mental-model" class="guide-section">
        <p class="eyebrow">01 · MENTAL MODEL</p>
        <h2>Know what is allowed to be authoritative.</h2>
        <div class="step-stack">
          {steps.map(([number, title, copy]) => (
            <article class="guide-step">
              <span>{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{copy}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="entry-paths" class="guide-section">
        <p class="eyebrow">02 · ENTRY PATHS</p>
        <h2>Enter through semantics, not meshes.</h2>
        <div class="choice-grid">
          <article>
            <span class="choice-label">IFC</span>
            <h3>Existing BIM model</h3>
            <p>Use IFC as architectural source truth and preserve GlobalIds when updating the same architectural elements.</p>
          </article>
          <article>
            <span class="choice-label">SH3D</span>
            <h3>Sweet Home 3D migration</h3>
            <p>The project direction is semantic SH3D → IFC conversion rather than importing OBJ geometry as canonical architecture.</p>
          </article>
          <article>
            <span class="choice-label">FIXTURE</span>
            <h3>Repository exploration</h3>
            <p>Use the deterministic golden-home fixtures to understand project, twin, scene, appearance, lighting, and live-state contracts.</p>
          </article>
        </div>
      </section>

      <section id="local" class="guide-section">
        <p class="eyebrow">03 · LOCAL SETUP</p>
        <h2>Run the repository contract checks.</h2>
        <div class="terminal" role="region" aria-label="Local setup commands">
          <div class="terminal-bar"><span></span><span></span><span></span><code>shell</code></div>
          <pre><code>git clone https://github.com/xtreemze/teldra.git
cd teldra
corepack enable
pnpm install
pnpm typecheck
pnpm test
pnpm ci</code></pre>
        </div>
        <p class="note">
          Current repository requirements are Node.js 24+ and pnpm 12.8.1.
        </p>
      </section>

      <section id="first-change" class="guide-section">
        <p class="eyebrow">04 · FIRST CHANGE</p>
        <h2>Follow dependency direction.</h2>
        <div class="dependency-strip">
          <span>schemas</span><b>→</b><span>domain</span><b>→</b><span>application</span><b>→</b><span>projection</span><b>→</b><span>adapters / renderers</span><b>→</b><span>apps</span>
        </div>
        <div class="do-dont">
          <article>
            <h3>Do</h3>
            <ul>
              <li>Express deterministic behavior as a test first.</li>
              <li>Keep canonical IDs stable across projections.</li>
              <li>Make coordinate and unit conversions explicit.</li>
              <li>Add browser coverage when behavior crosses renderer boundaries.</li>
            </ul>
          </article>
          <article>
            <h3>Avoid</h3>
            <ul>
              <li>Putting renderer objects into domain contracts.</li>
              <li>Using Home Assistant entity IDs as canonical identity.</li>
              <li>Letting camera, drag, filter, or layout state rewrite canonical placement.</li>
              <li>Treating GLB, Blend files, or baked assets as source truth.</li>
            </ul>
          </article>
        </div>
        <div class="guide-actions">
          <a class="button primary" href="https://github.com/xtreemze/teldra/blob/main/AGENTS.md">Read contributor contract</a>
          <a class="button secondary" href="https://github.com/xtreemze/teldra/tree/main/docs/architecture">Open architecture docs</a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
