---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const layers = [
  ["IFC", "Architectural truth", "Geometry, spaces, openings, storeys, and stable building identity."],
  ["Twin", "Smart-home truth", "Devices, capabilities, bindings, observations, and runtime semantics."],
  ["Projection", "Renderer-neutral", "One stable representation feeds physical, analytical, and authoring views."],
];

const principles = [
  ["Canonical first", "IFC and the versioned Teldra twin format remain authoritative. Renderers never become the database."],
  ["One identity space", "Building references, devices, capabilities, and bindings resolve through stable Teldra identity."],
  ["Derived by design", "GLB, baked lighting, cameras, GPU resources, and visualization state are outputs—not source truth."],
  ["Adapter boundaries", "Home Assistant is the first automation adapter, while Babylon.js, deck.gl, and Blender remain replaceable execution layers."],
];
---

<BaseLayout
  title="Teldra — a BIM-backed smart-home digital twin"
  description="Teldra combines IFC building semantics with smart-home state, interactive 3D, analytical overlays, and high-quality offline rendering."
>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">BUILDING TRUTH · LIVE STATE · SPATIAL COMPUTING</p>
      <h1>Your home, modeled as a system—not a dashboard.</h1>
      <p class="hero-lede">
        Teldra combines BIM semantics, smart-home state, interactive 3D, analytical
        visualization, and offline rendering without letting any one renderer own the model.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}onboarding/`}>Start onboarding</a>
        <a class="button secondary" href="https://github.com/xtreemze/teldra">View repository</a>
      </div>
      <div class="hero-meta" aria-label="Project characteristics">
        <span>IFC authoritative</span>
        <span>Renderer-neutral</span>
        <span>Home Assistant ready</span>
      </div>
    </div>

    <div class="twin-window" aria-label="Diagram showing Teldra's twin architecture">
      <div class="window-bar">
        <span></span><span></span><span></span>
        <code>teldra / twin</code>
      </div>
      <div class="scene">
        <div class="room-grid" aria-hidden="true"></div>
        <div class="room-card room-card-a">
          <small>SPACE</small>
          <strong>Living room</strong>
          <span>21.4 °C · occupied</span>
        </div>
        <div class="room-card room-card-b">
          <small>LIGHT</small>
          <strong>Floor lamp</strong>
          <span>35% · warm</span>
        </div>
        <div class="node-line line-a" aria-hidden="true"></div>
        <div class="node-line line-b" aria-hidden="true"></div>
        <div class="scene-node node-a" aria-hidden="true"></div>
        <div class="scene-node node-b" aria-hidden="true"></div>
        <div class="scene-node node-c" aria-hidden="true"></div>
      </div>
      <div class="window-footer">
        <span>IFC GlobalId</span>
        <span>Teldra ID</span>
        <span>HA binding</span>
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="section-shell compact">
      <p class="eyebrow">THE MODEL</p>
      <h2>Two sources of truth. One explorable twin.</h2>
      <p class="section-intro">
        The building and the smart-home system evolve at different rates. Teldra keeps both
        canonical, then projects them into the views that people and tools need.
      </p>
    </div>
  </section>

  <section id="architecture" class="section-shell architecture">
    <div class="layer-grid">
      {layers.map(([name, label, copy], index) => (
        <article class="layer-card">
          <span class="step-index">0{index + 1}</span>
          <p class="eyebrow">{label}</p>
          <h3>{name}</h3>
          <p>{copy}</p>
        </article>
      ))}
    </div>
    <div class="flow" aria-label="Teldra renderer flow">
      <div class="flow-source">building.ifc</div>
      <span>+</span>
      <div class="flow-source">twin.json</div>
      <span>→</span>
      <div class="flow-core">TwinProjection</div>
      <span>→</span>
      <div class="flow-targets">
        <span>Babylon</span><span>deck.gl</span><span>Blender</span>
      </div>
    </div>
  </section>

  <section id="principles" class="principles">
    <div class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">DESIGN PRINCIPLES</p>
          <h2>Built to stay understandable as the twin grows.</h2>
        </div>
        <p>
          The architecture keeps identity, spatial semantics, mutation, rendering, and
          automation integration explicit and testable.
        </p>
      </div>
      <div class="principle-grid">
        {principles.map(([title, copy]) => (
          <article>
            <div class="principle-dot" aria-hidden="true"></div>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell onboarding-cta">
    <div>
      <p class="eyebrow">ONBOARDING</p>
      <h2>Start from the model you already have.</h2>
      <p>
        Learn Teldra's authority model, choose an IFC or Sweet Home 3D entry path, and run
        the repository locally without crossing domain boundaries.
      </p>
    </div>
    <a class="button primary" href={`${base}onboarding/`}>Open the guide</a>
  </section>
</BaseLayout>
