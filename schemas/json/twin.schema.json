{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teldra.dev/schema/twin/0.1.0",
  "title": "Teldra Twin",
  "type": "object",
  "required": ["schemaVersion", "building", "devices", "bindings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "building": {
      "type": "object",
      "required": ["ifcSchema", "refs"],
      "additionalProperties": false,
      "properties": {
        "ifcSchema": {
          "const": "IFC4"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildingReference"
          }
        },
        "sitePlacement": {
          "$ref": "#/$defs/sitePlacement"
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "buildingReference": {
      "type": "object",
      "required": ["id", "ifcGlobalId", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ifcGlobalId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22
        },
        "kind": {
          "enum": [
            "site",
            "building",
            "storey",
            "space",
            "wall",
            "slab",
            "roof",
            "door",
            "window",
            "furniture",
            "fixture",
            "distribution-element",
            "other"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["light", "opening", "sensor", "climate", "media", "switch"]
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "buildingRefId": {
          "$ref": "#/$defs/id"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "placement": {
          "description": "Device pose in the IFC world coordinate frame, in metres with Z up. Quaternion order is x, y, z, w.",
          "type": "object",
          "additionalProperties": false,
          "required": ["frame", "position", "rotationQuaternion"],
          "properties": {
            "frame": { "const": "ifc-world-metres-z-up" },
            "position": { "$ref": "#/$defs/vector3" },
            "rotationQuaternion": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
          }
        }
      }
    },
    "instant": {
      "description": "UTC RFC 3339 instant, e.g. 2026-01-02T03:04:05Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sitePlacement": {
      "description": "Provider-independent geographic placement of the building. The anchor is where the IFC local origin (0,0,0) sits on Earth; IFC geometry is never rewritten. Building local axes are X east, Y north (project north), Z up before orientation is applied.",
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "orientation", "provenance"],
      "properties": {
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "latitudeDegrees", "longitudeDegrees", "height"],
          "properties": {
            "crs": { "const": "EPSG:4326" },
            "latitudeDegrees": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitudeDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
            "height": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metres", "reference"],
              "properties": {
                "metres": { "type": "number" },
                "reference": {
                  "description": "ellipsoidal: metres above the WGS84 ellipsoid. orthometric: metres above a named vertical datum (mean sea level); requires verticalDatum.",
                  "enum": ["ellipsoidal", "orthometric"]
                },
                "verticalDatum": { "type": "string", "minLength": 1 },
                "geoidSeparationMetres": {
                  "description": "Ellipsoidal height minus orthometric height at the anchor. Required to derive an ellipsoidal height from an orthometric one.",
                  "type": "number"
                }
              }
            }
          }
        },
        "orientation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["northReference", "projectNorthBearingDegrees"],
          "properties": {
            "northReference": {
              "description": "Geographic (true) north, not grid north or magnetic north.",
              "const": "geographic-north"
            },
            "projectNorthBearingDegrees": {
              "description": "Clockwise bearing, in degrees from geographic north, of the building local +Y axis (project north).",
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "dataset", "retrievedAt"],
          "properties": {
            "status": { "enum": ["provisional", "user-confirmed"] },
            "source": { "type": "string", "minLength": 1 },
            "dataset": { "type": "string", "minLength": 1 },
            "sourceObjectId": { "type": "string", "minLength": 1 },
            "retrievedAt": { "$ref": "#/$defs/instant" },
            "confirmedAt": { "$ref": "#/$defs/instant" },
            "attribution": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "vector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "binding": {
      "type": "object",
      "required": ["id", "deviceId", "adapter", "externalId"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "deviceId": {
          "$ref": "#/$defs/id"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
