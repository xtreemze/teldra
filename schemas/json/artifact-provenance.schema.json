{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teldra.dev/schema/artifact-provenance/0.1.0",
  "title": "Teldra Derived Artifact Provenance",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifact",
    "sourceCommit",
    "toolchainManifestSha256",
    "producer",
    "components",
    "settingsSha256",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "toolchainManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "settingsSha256": {
      "$ref": "#/$defs/sha256"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ifc",
            "glb",
            "scene-manifest",
            "appearance-manifest",
            "lighting-manifest",
            "lightmap",
            "reflection-probe",
            "render",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
