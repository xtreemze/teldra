    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "23.2.1",
    "eslint": "9.39.1",
    "nx": "23.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
