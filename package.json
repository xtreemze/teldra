{
  "name": "teldra",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --filter @teldra/contracts generate",
